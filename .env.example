# Copy this file to ".env" and edit the values. Never commit ".env" to Git.

# --- Django ---
DJANGO_DEBUG=True
# Generate your own key:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to True only when the site is served over HTTPS (production)
DJANGO_HTTPS=False

# --- Database ---
# "sqlite" works immediately with no setup (default, good for development).
# Change to "mysql" once you have created the MySQL database (see README).
DB_ENGINE=sqlite
DB_NAME=ai_hub
DB_USER=ai_hub_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Email (password reset) ---
# In development reset emails are printed in the terminal (console backend).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=AI HUB <no-reply@example.com>
# Only needed for a real SMTP server:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- Public contact address shown on the Contact page (optional) ---
CONTACT_EMAIL=
